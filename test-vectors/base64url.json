{
 "about": "Reading base64url strictly (format description, section 3.3).",
 "function": "fromBase64url",
 "cases": [
  {
   "name": "empty",
   "text": "",
   "expected": {
    "ok": ""
   }
  },
  {
   "name": "one byte",
   "text": "AA",
   "expected": {
    "ok": "00"
   }
  },
  {
   "name": "two bytes",
   "text": "AAE",
   "expected": {
    "ok": "0001"
   }
  },
  {
   "name": "three bytes",
   "text": "AAEC",
   "expected": {
    "ok": "000102"
   }
  },
  {
   "name": "an impossible length",
   "text": "A",
   "expected": {
    "refused": {
     "code": "bad-base64url",
     "message": "A base64url value has an impossible length."
    }
   }
  },
  {
   "name": "padding",
   "text": "AA==",
   "expected": {
    "refused": {
     "code": "bad-base64url",
     "message": "A base64url value holds a character that is not allowed."
    }
   }
  },
  {
   "name": "stray bits",
   "text": "AB",
   "expected": {
    "refused": {
     "code": "bad-base64url",
     "message": "A base64url value has stray bits in its last character."
    }
   }
  },
  {
   "name": "a plus sign",
   "text": "a+b_",
   "expected": {
    "refused": {
     "code": "bad-base64url",
     "message": "A base64url value holds a character that is not allowed."
    }
   }
  },
  {
   "name": "a character outside ASCII",
   "text": "AAAé",
   "expected": {
    "refused": {
     "code": "bad-base64url",
     "message": "A base64url value holds a character that is not allowed."
    }
   }
  },
  {
   "name": "an astral character",
   "text": "AAA😀",
   "expected": {
    "refused": {
     "code": "bad-base64url",
     "message": "A base64url value has an impossible length."
    }
   }
  },
  {
   "name": "all the alphabet",
   "text": "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_",
   "expected": {
    "ok": "00108310518720928b30d38f41149351559761969b71d79f8218a39259a7a29aabb2dbafc31cb3d35db7e39ebbf3dfbf"
   }
  }
 ]
}
