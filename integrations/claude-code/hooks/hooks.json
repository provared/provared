{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PLUGIN_ROOT}/recorder.mjs", "session-start"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PLUGIN_ROOT}/hook.mjs"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PLUGIN_ROOT}/hook.mjs"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PLUGIN_ROOT}/hook.mjs"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
