{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/integrations/claude-code/recorder.mjs", "ensure"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/integrations/claude-code/hook.mjs"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/integrations/claude-code/hook.mjs"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/integrations/claude-code/hook.mjs"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
