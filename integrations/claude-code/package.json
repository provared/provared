{
  "name": "provared-claude-code",
  "version": "0.2.0",
  "description": "Records a Claude Code agent with Provared: its tool calls are checked against a permission a person signed with a passkey, refused if they are outside it, and receipted if they are taken. Eight tools that only talk to the person or change what the model itself holds are not recorded. Evidence, not a verdict.",
  "author": "Pavel Izmaylov",
  "license": "Apache-2.0 AND CC-BY-4.0",
  "homepage": "https://prova.red",
  "bugs": "https://github.com/provared/provared/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/provared/provared.git",
    "directory": "integrations/claude-code"
  },
  "keywords": [
    "claude-code",
    "claude-code-hooks",
    "ai-agent",
    "agent",
    "audit-trail",
    "permission",
    "authorization",
    "receipt",
    "tamper-evident",
    "passkey",
    "evidence"
  ],
  "type": "module",
  "bin": {
    "provared-claude-code": "recorder.mjs",
    "provared-witness": "witness.mjs"
  },
  "files": [
    "recorder.mjs",
    "hook.mjs",
    "settings-hooks.mjs",
    "actions.mjs",
    "feed.mjs",
    "port.mjs",
    "waiting.mjs",
    "witness.mjs",
    "witnessed.mjs",
    "proofs.mjs",
    "LICENSE-CC-BY-4.0.txt"
  ],
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs"
  },
  "dependencies": {
    "provared": "^0.8.0"
  }
}
