# Local notes and editor settings: never committed.
CLAUDE.local.md
.claude/settings.local.json

# Never commit secrets or machine files
.env
.env.*
*.key
*.pem
*.jwk
*.seed
node_modules/
# The checking page built as a single file (tools/make-single-page.mjs)
provared-check.html
.DS_Store
Thumbs.db

# The Python version's own environment and caches
python/.venv/
__pycache__/
*.egg-info/
python/build/
python/dist/
python/integrations/*/build/
python/integrations/*/dist/

# The environment in which the examples for agent frameworks are run
python/.venv-examples/
python/integrations/*/.venv/

# The record's book and the checker's answer at prova.red/records/ grow by megabytes a day:
# they are kept in the release "record", with their fingerprints in site/records/files.sha256.
# So are the books the recorder has kept (book-1.jsonl and on) and their answers.
site/records/book.jsonl
site/records/checker-answer.txt
site/records/book-*.jsonl
site/records/checker-answer-*.txt
