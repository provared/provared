# Local notes and editor settings: never committed.
CLAUDE.local.md
.claude/settings.local.json

# Never commit secrets or machine files
.env
.env.*
*.key
*.pem
*.jwk
*.seed
node_modules/
# The checking page built as a single file (tools/make-single-page.mjs)
provared-check.html
.DS_Store
Thumbs.db

# The Python version's own environment and caches
python/.venv/
__pycache__/
*.egg-info/
python/build/
python/dist/

# The environment in which the examples for agent frameworks are run
python/.venv-examples/
