{
  "about": "Calls, and the action, amount and service each must map to under these settings, or the code it must be refused with. 'target' is the address as the agent sends it to the gateway; 'forwarded' is the address the gateway sends the call to. A body is given as text ('body') or, where it is not text, in base64 ('bodyBase64'). Read by test/rules.test.mjs.",
  "settings": {
    "upstreams": {
      "tickets": {
        "base": "https://tickets.example.invalid",
        "service": "tickets"
      },
      "patch": {
        "base": "https://patch.example.invalid/svc/",
        "service": "patch",
        "caseSensitive": true
      },
      "files": {
        "base": "https://files.example.invalid"
      },
      "matrix": {
        "base": "https://matrix.example.invalid",
        "semicolons": true
      }
    },
    "rules": [
      {
        "upstream": "tickets",
        "method": "GET",
        "path": "/api/now/table/:table",
        "action": "provared.data.read"
      },
      {
        "upstream": "tickets",
        "method": "PATCH",
        "path": "/api/now/table/change_request/:id",
        "action": "ticket.update"
      },
      {
        "upstream": "tickets",
        "method": "PATCH",
        "path": "/api/now/table/:table/:id",
        "action": "provared.data.change"
      },
      {
        "upstream": "patch",
        "method": "POST",
        "path": "/v1/waves",
        "action": "patch.apply",
        "amount": {
          "unit": "hosts",
          "count": "/hosts"
        }
      },
      {
        "upstream": "patch",
        "method": "POST",
        "path": "/v1/hosts/:id/reboot",
        "action": "host.reboot",
        "amount": {
          "unit": "hosts",
          "value": 1
        }
      },
      {
        "upstream": "patch",
        "method": "POST",
        "path": "/v1/budget",
        "action": "patch.budget",
        "amount": {
          "unit": "GBP",
          "pointer": "/plan/total"
        }
      },
      {
        "upstream": "patch",
        "method": "POST",
        "path": "/v1/escaped",
        "action": "patch.budget",
        "amount": {
          "unit": "GBP",
          "pointer": "/a~1b/m~0n"
        }
      },
      {
        "upstream": "patch",
        "method": "POST",
        "path": "/v1/listed",
        "action": "patch.budget",
        "amount": {
          "unit": "GBP",
          "pointer": "/items/0"
        }
      },
      {
        "upstream": "patch",
        "method": "POST",
        "path": "/v1/listed-badly",
        "action": "patch.budget",
        "amount": {
          "unit": "GBP",
          "pointer": "/items/01"
        }
      },
      {
        "upstream": "files",
        "method": "DELETE",
        "path": "/api/files/:id",
        "search": "mode=purge",
        "action": "provared.data.delete"
      },
      {
        "upstream": "files",
        "method": "DELETE",
        "path": "/api/files/:id",
        "action": "files.archive"
      },
      {
        "upstream": "files",
        "method": "GET",
        "path": "/",
        "action": "provared.data.read"
      },
      {
        "upstream": "files",
        "method": "GET",
        "path": "/api/folders/:path*",
        "action": "provared.data.read"
      },
      {
        "upstream": "matrix",
        "method": "DELETE",
        "path": "/admin/:id",
        "action": "provared.data.delete"
      },
      {
        "upstream": "matrix",
        "method": "DELETE",
        "path": "/public/:rest*",
        "action": "files.archive"
      }
    ]
  },
