{
  "name": "provared-mcp-executor",
  "version": "0.1.0",
  "description": "An executor for MCP tool servers: it stands between an agent and its tool servers, holds the servers' credentials, checks each tool call against a permission a person signed with a passkey, sends on the calls the permission allows, and writes a signed, countersigned Provared receipt for each. Evidence, not a verdict.",
  "author": "Pavel Izmaylov",
  "license": "Apache-2.0 AND CC-BY-4.0",
  "homepage": "https://prova.red",
  "bugs": "https://github.com/provared/provared/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/provared/provared.git",
    "directory": "mcp-executor"
  },
  "keywords": [
    "ai-agent",
    "agent",
    "mcp",
    "model-context-protocol",
    "executor",
    "proxy",
    "audit-trail",
    "permission",
    "authorization",
    "receipt",
    "tamper-evident",
    "passkey",
    "evidence"
  ],
  "type": "module",
  "main": "./executor.mjs",
  "exports": {
    ".": "./executor.mjs",
    "./compare": "./compare.mjs",
    "./jsonrpc": "./jsonrpc.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "provared-mcp-executor": "bin.mjs"
  },
  "files": [
    "executor.mjs",
    "compare.mjs",
    "copy.mjs",
    "jsonrpc.mjs",
    "files.mjs",
    "bin.mjs",
    "executor.example.json",
    "DESIGN.md",
    "LICENSE-CC-BY-4.0.txt"
  ],
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test --test-timeout=60000 test/*.test.mjs"
  },
  "dependencies": {
    "provared": ">0.6.0 <0.8.0"
  }
}
